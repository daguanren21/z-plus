{
  "name": "@daguanren21/z-plus",
  "type": "module",
  "version": "2.0.1",
  "description": "vue lib vite lib mode template",
  "author": "daguanren21 <1363917353@qq.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daguanren21/z-plus.git",
    "directory": "packages/vue-lib-template"
  },
  "bugs": {
    "url": "https://github.com/daguanren21/z-plus/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./lib/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.umd.cjs"
      },
      "./style.css": "./dist/index.css"
    },
    "main": "./dist/index.umd.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "es-toolkit": "^1.52.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/vue3-vite": "^9.1.20",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-storybook": "^9.1.20",
    "jsdom": "^26.1.0",
    "sass-embedded": "^1.104.0",
    "storybook": "^9.1.20",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
